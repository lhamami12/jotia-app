rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid in ['m0KLPC7hW2TOtEsoX57UcUKMxTR2']; }

    match /deletionRequests/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update, delete: if false;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /conversations/{conversationId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.buyerId
        && request.auth.uid in request.resource.data.participants
        && conversationId == request.resource.data.listingId + '_' + request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId
        && !('isBlocked' in request.resource.data));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked']));
      allow delete: if false;
    }

    match /favorites/{favId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerId != request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
